# Copy to .env for local use (never commit .env).
# Meg loads .env from the current folder, then ~/.meg/.env. Real environment
# variables always win. The desktop app saves a key you enter to ~/.meg/.env.
# Keys are only needed for the assistant; QC (meg check) works without one.

ANTHROPIC_API_KEY=your_anthropic_key_here
# OPENAI_API_KEY=your_openai_key_here

# Optional default provider when both keys are set (otherwise Claude is preferred)
# MEG_PROVIDER=anthropic

# Optional stall timeout for ffmpeg execution (seconds without stderr output)
# MEG_EXEC_STALL_TIMEOUT_S=180

# Optional model IDs (override built-in defaults per provider)
# MEG_ANTHROPIC_MODEL=claude-sonnet-4-5
# MEG_OPENAI_MODEL=gpt-5
